# Python & Virtual Environments
__pycache__/
*.py[cod]
.venv/
env/

# Operating System Files
.DS_Store
Thumbs.db

# Exclude large raw and processed datasets (>50MB / 100MB)
data/raw/*
data/processed/*
*.parquet

# Explicitly keep folder structure and preview samples
!data/**/.gitkeep
!data/raw/*_sample.csv
!data/processed/*_sample.csv

# Models
models/*.pkl
models/*.joblib